{
  "name": "glass-ui",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "description": "A Glassmorphism UI component library for Vue 3",
  "files": [
    "dist"
  ],
  "author": "George Blackbird",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeorgeBlackbird/glass-ui"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "glassmorphism"
  ],
  "homepage": "https://github.com/GeorgeBlackbird/glass-ui#",
  "bugs": "https://github.com/GeorgeBlackbird/glass-ui/issues",
  "main": "./dist/glass-ui.umd.js",
  "module": "./dist/glass-ui.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/glass-ui.es.js",
      "require": "./dist/glass-ui.umd.js"
    },
    "./styles": "./dist/style.css",
    "./styles/*": "./src/lib/styles/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "release": "npm version patch && npm publish"
  },
  "dependencies": {
    "vue": "^3.2.37"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "sass": "^1.93.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.6",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.0.7"
  },
  "peerDependencies": {
    "vue": "^3.2.37"
  },
  "lint-staged": {
    "*.{js,ts,vue,scss}": "prettier --write",
    "*.{js,ts,vue}": "eslint --fix"
  }
}